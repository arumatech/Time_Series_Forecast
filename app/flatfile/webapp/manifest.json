{
  "_version": "1.86.0",
  "sap.app": {
    "id": "flatfile",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "7baca07e-6efd-464e-a3ed-52006d8d5cb1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/catalog/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "flatfile-display": {
          "semanticObject": "flatfile",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
    "sap.m": {},
    "sap.ui.core": {},
    "sap.ui.unified": {},
    "sap.fe.templates": {}
    }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "flatfile.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FLATFILEList",
          "target": "FLATFILEList"
        },
        {
          "pattern": "FLATFILE({key}):?query:",
          "name": "FLATFILEObjectPage",
          "target": "FLATFILEObjectPage"
        }
      ],
      "targets": {
        "FLATFILEList": {
          "type": "Component",
          "id": "FLATFILEList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/FLATFILE",
              "variantManagement": "Page",
              "navigation": {
                "FLATFILE": {
                  "detail": {
                    "route": "FLATFILEObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "uploadCSV": {
                      "id": "uploadCSV",
                      "text": "Upload CSV",
                      "press": ".extension.flatfile.ext.controller.ListReportExt.onUploadCSV",
                      "requiresSelection": false
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "FLATFILEObjectPage": {
          "type": "Component",
          "id": "FLATFILEObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FLATFILE"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "flatfile.ext.controller.ListReportExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "TIME_SERIES_FORECAST.service"
  }
}