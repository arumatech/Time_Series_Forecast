COLUMN TABLE "TBAC_DCS_MIC_SOURCE"(
	"CLIENT" NVARCHAR(3) DEFAULT '000' NOT NULL COMMENT 'Client',
	"DCSID" NVARCHAR(20) DEFAULT '' NOT NULL COMMENT 'Derivative Contract Specification ID',
	"MIC" NVARCHAR(4) DEFAULT '' NOT NULL COMMENT 'Market Identifier Code',
	"NOT_RELEASED" NVARCHAR(1) DEFAULT '' NOT NULL COMMENT 'DCS/MIC Assignment not yet released',
	PRIMARY KEY INVERTED VALUE(
		"CLIENT",
		"DCSID",
		"MIC"
	)
)
UNLOAD PRIORITY 5 AUTO MERGE
COMMENT 'Dervative contract specification - MIC';